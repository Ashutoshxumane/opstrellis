# --- core ---
PORT=8787
DATABASE_URL=postgres://postgres:postgres@localhost:5432/opstrellis
# Public origin of this server (used for links, the cookie Secure flag and the CSRF origin check)
PUBLIC_URL=http://localhost:8787
# Number of reverse proxies in front of the server (1 for one); rate limits then use the client IP
# that many entries from the right of X-Forwarded-For
TRUST_PROXY=0
# Encrypts upstream provider keys saved from the admin UI (long random string; do not change later)
MASTER_KEY=change-me-to-a-long-random-string
# Used by `npm run db:seed` to create/promote an admin (otherwise only the first signup is admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- self-hosted model (provider "local") ---
# Directory containing model folders; a catalog entry's upstream_model is the folder name
LOCAL_MODEL_DIR=models
LOCAL_NUM_THREADS=2

# --- upstream provider keys (used when none is saved in the admin UI) ---
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
ELEVENLABS_API_KEY=
GOOGLE_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
# Optional base URL overrides (<PROVIDER>_BASE_URL), e.g. a self-hosted OpenAI-compatible server
# OPENAI_BASE_URL=http://localhost:8000/v1

# --- Stripe (leave STRIPE_SECRET_KEY empty for manual billing) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Recurring $12/month price for Pro
STRIPE_PRICE_PRO=
# Metered price attached to the Billing Meter below ($0.02 per unit = minute)
STRIPE_PRICE_OVERAGE=
STRIPE_METER_EVENT=opstrellis_managed_minutes

# Node fetch behind an HTTP(S) proxy
# NODE_USE_ENV_PROXY=1
